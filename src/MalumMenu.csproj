
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <DebugType>embedded</DebugType>

        <VersionPrefix>3.3.1</VersionPrefix>
        <Description>all play and no cheats makes among us a dull game</Description>
        <Authors>scp222thj, astra1dev</Authors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.9.29" PrivateAssets="all" />
        <PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

    <Target Name="LoadEnv" BeforeTargets="Build">
        <ReadLinesFromFile File="$(MSBuildProjectDirectory)/.env"
                          Condition="Exists('$(MSBuildProjectDirectory)/.env')">
            <Output TaskParameter="Lines" ItemName="_EnvLines" />
        </ReadLinesFromFile>

        <PropertyGroup>
            <BuildDestination Condition="'%(_EnvLines.Identity)' != '' and $([System.String]::Copy('%(_EnvLines.Identity)').StartsWith('BUILD_DESTINATION='))">$([System.String]::Copy('%(_EnvLines.Identity)').Substring(18))</BuildDestination>
        </PropertyGroup>
    </Target>

    <Target Name="Copy" AfterTargets="Build" Condition="'$(BuildDestination)' != ''">
        <MakeDir Directories="$(BuildDestination)" />
        <Copy SourceFiles="$(TargetPath)"
              DestinationFolder="$(BuildDestination)"
              SkipUnchangedFiles="true" />
    </Target>
</Project>